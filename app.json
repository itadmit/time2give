{
  "expo": {
    "name": "Time2Give",
    "slug": "time4giving",
    "version": "0.1.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "time4giving",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/03647ef1-c3b4-4f9b-ad18-36a152cb7476"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.time4giving.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "האפליקציה משתמשת במיקומך כדי להציג תרומות קרובות אליך. מיקומך אינו נשמר בשרת.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.time4giving.app",
      "adaptiveIcon": {
        "backgroundColor": "#1D4E7C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#1D4E7C"
        }
      ],
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "03647ef1-c3b4-4f9b-ad18-36a152cb7476"
      }
    },
    "owner": "quickshopil"
  }
}
